{
  "name": "bheem",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BHEEM - 2D side-scrolling action platformer-brawler (Phaser 3 + TypeScript + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "boss:sim": "vite-node tools/bossSim.ts",
    "check:secrets": "node -e \"const fs=require('fs'),path=require('path');const bad=[];const walk=d=>fs.readdirSync(d).forEach(n=>{const q=path.join(d,n);fs.statSync(q).isDirectory()?walk(q):/RUN_TOKEN_SECRET|ADMIN_KEY/.test(fs.readFileSync(q,'utf8'))&&bad.push(q)});walk('dist');if(bad.length){console.error('secret names in bundle:',bad);process.exit(1)}\""
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^20.19.43",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
